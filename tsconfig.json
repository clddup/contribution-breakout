{
  "compilerOptions": {
    "lib": ["DOM", "ES2024"],
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "action-dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
